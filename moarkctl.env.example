# Copy to .moarkctl.env, fill it locally, then run: chmod 600 .moarkctl.env

MOARK_TOKEN=replace-me

# Optional. No instance ID is required: `mc ls` discovers every instance.
# Set this to an exact platform name, full ID, or unique ID prefix only if one
# instance should be selected when `mc on`, `mc off`, or `mc re` has no target.
MOARK_DEFAULT_INSTANCE=

MOARK_BASE_URL=https://api.moark.com/v1
MOARK_HTTP_TIMEOUT=60
MOARK_POLL_INTERVAL=8
MOARK_POLL_TIMEOUT=600
