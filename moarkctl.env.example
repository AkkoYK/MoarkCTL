# MoarkCTL user configuration
# Preferred setup: run `mc init`, then edit ~/.config/moarkctl/config.env.

MOARK_TOKEN=

# Optional. No instance ID is required: `mc ls` discovers every instance.
# Set this only after discovery, using an exact name, full ID, or unique ID
# prefix when one container should be the default lifecycle target.
MOARK_DEFAULT_INSTANCE=

# Optional local aliases. Copy a full ID from `mc ls --json`.
# The suffix is lowercased and `_` becomes `-`, so this creates `npu-910b`.
# MOARK_INSTANCE_NPU_910B=NHRNUEKVXXGAEI1U

MOARK_BASE_URL=https://api.moark.com/v1
MOARK_HTTP_TIMEOUT=60
MOARK_POLL_INTERVAL=8
MOARK_POLL_TIMEOUT=600
